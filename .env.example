# TermMap - example environment file. Copy to .env (which is git-ignored) and edit if needed.
# NO API KEY IS REQUIRED: everything runs locally; no data is sent to any external service.
# All values are optional overrides; defaults live in configs/default.yaml.

# Challenge files (proprietary - keep outside version control)
TERMMAP_TRAIN_PATH=data/hackathon_train.csv
TERMMAP_ICD_PATH=resources/icd10cm_codes.xlsx
TERMMAP_SNOMED_PATH=resources/SNOMEDCT_US_codes_and_descriptions.xlsx

# Hash-keyed caches (embeddings, indexes)
TERMMAP_CACHE_DIR=resources/cache

# Optional auxiliary resources (the engine runs without them)
TERMMAP_CROSSWALK_PATH=
TERMMAP_SNOMED_RELATIONSHIPS_PATH=

# Optional local encoder snapshot for the dense channel (GPU stages)
TERMMAP_DENSE_MODEL_PATH=

# Keep Hugging Face offline at inference time
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
